<Window x:Class="XCapture.Windows.ImageMergeOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 합치기 순서" Width="650" Height="520" MinWidth="480" MinHeight="350" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="합칠 순서를 정해주세요. 위에서부터 이미지가 이어지거나 PDF 페이지로 저장됩니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="이미지 추가" MinWidth="90" Height="34" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="위로" Width="65" Height="34" Margin="0,0,8,0" Click="Up_Click"/>
            <Button Content="아래로" Width="65" Height="34" Margin="0,0,8,0" Click="Down_Click"/>
            <Button Content="목록에서 제거" MinWidth="100" Height="34" Margin="0,0,8,0" Click="Remove_Click"/>
            <Button Content="다음" Width="75" Height="34" Click="Continue_Click"/>
        </StackPanel>
        <ListBox x:Name="ImageList" DisplayMemberPath="DisplayName" HorizontalContentAlignment="Stretch"/>
    </DockPanel>
</Window>
