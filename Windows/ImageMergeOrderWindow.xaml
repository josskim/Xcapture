<Window x:Class="XCapture.Windows.ImageMergeOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XViewer - 이미지 합치기" Width="1100" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#F9FAFB">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="사진을 보면서 순서를 정하세요. 위에서부터 이미지가 이어지거나 PDF 페이지로 저장됩니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="이미지 추가" MinWidth="90" Height="36" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="위로" Width="70" Height="36" Margin="0,0,8,0" Click="Up_Click"/>
            <Button Content="아래로" Width="70" Height="36" Margin="0,0,8,0" Click="Down_Click"/>
            <Button Content="목록에서 제거" MinWidth="105" Height="36" Margin="0,0,8,0" Click="Remove_Click"/>
            <Button Content="다른 이름으로 저장" MinWidth="145" Height="36" Click="Continue_Click"/>
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="ImageList" Background="#1F2937" Foreground="White" BorderBrush="#374151" SelectionChanged="ImageList_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" Background="White"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SizeText}" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#374151" BorderThickness="1" Margin="12,0,0,0">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    <TextBlock x:Name="PreviewText" Grid.Row="1" Margin="0,10,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
