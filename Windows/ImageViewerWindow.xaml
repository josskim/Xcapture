<Window x:Class="XCapture.Windows.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XViewer"
        Width="1120"
        Height="780"
        MinWidth="720"
        MinHeight="480"
        Background="#111827"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ViewerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <ContextMenu x:Key="ImageContextMenu" x:Shared="False">
            <MenuItem Header="이미지 복사" Click="CopyContextMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1"
                Padding="14,11">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               Foreground="#F9FAFB"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ImageInfoText"
                               Margin="0,3,0,0"
                               Foreground="#9CA3AF"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="열기" Click="OpenButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="복사" Click="CopyButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="저장" Click="SaveButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="인쇄" Click="PrintButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="이미지 합치기" Click="MergeButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="크기·형식 변환" Click="ConvertButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="파일 위치" Click="OpenLocationButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="캡처 목록" Click="CaptureListButton_Click" Style="{StaticResource ViewerButtonStyle}" Margin="0"/>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="ViewToolButton" Content="보기" Click="ViewToolButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button x:Name="PenToolButton" Content="펜" Click="PenToolButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button x:Name="EraserToolButton" Content="지우개" Click="EraserToolButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Background="#EF4444" Tag="#EF4444" ToolTip="빨강" Click="ColorButton_Click" Width="28" Height="28" Margin="0,3,6,3"/>
                    <Button Background="#2563EB" Tag="#2563EB" ToolTip="파랑" Click="ColorButton_Click" Width="28" Height="28" Margin="0,3,6,3"/>
                    <Button Background="#111827" Tag="#111827" ToolTip="검정" Click="ColorButton_Click" Width="28" Height="28" Margin="0,3,6,3"/>
                    <Button Background="#FACC15" Tag="#FACC15" ToolTip="노랑" Click="ColorButton_Click" Width="28" Height="28" Margin="0,3,12,3"/>
                    <TextBlock Text="굵기" Foreground="#F9FAFB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="StrokeSlider" Width="100" Minimum="2" Maximum="18" Value="4" VerticalAlignment="Center" Margin="0,0,12,0" ValueChanged="StrokeSlider_ValueChanged"/>
                    <Button Content="되돌리기" Click="UndoButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="초기화" Click="ClearButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                Padding="12">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Button x:Name="PreviousButton" Content="이전" Click="PreviousButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button x:Name="NextButton" Content="다음" Click="NextButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <TextBlock x:Name="PositionText" VerticalAlignment="Center" Foreground="#D1D5DB" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="−" Click="ZoomOutButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="44"/>
                    <Button Content="맞춤" Click="FitButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="1:1" Click="ActualSizeButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="52"/>
                    <Button Content="+" Click="ZoomInButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="44"/>
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Foreground="#F9FAFB" FontWeight="SemiBold" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#6B7280"
                           Text="← → 이동 · Ctrl+휠 확대 · 파일 끌어놓기"/>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="ImageScrollViewer"
                      Background="#111827"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Loaded="ImageScrollViewer_Loaded"
                      SizeChanged="ImageScrollViewer_SizeChanged"
                      PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
            <Grid x:Name="ImageSurface"
                  Margin="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Border Background="#FFFFFF"
                        BorderBrush="#374151"
                        BorderThickness="1">
                    <Image x:Name="ViewerImage"
                           ContextMenu="{StaticResource ImageContextMenu}"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <InkCanvas x:Name="InkLayer" Background="Transparent" IsHitTestVisible="False" EditingMode="None" ContextMenu="{StaticResource ImageContextMenu}"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
