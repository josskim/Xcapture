<Window x:Class="XCapture.Windows.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XCapture 이미지 뷰어"
        Width="1120"
        Height="780"
        MinWidth="720"
        MinHeight="480"
        Background="#111827"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ViewerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <ContextMenu x:Key="ImageContextMenu" x:Shared="False">
            <MenuItem Header="이미지 복사" Click="CopyContextMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1"
                Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               Foreground="#F9FAFB"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ImageInfoText"
                               Margin="0,3,0,0"
                               Foreground="#9CA3AF"
                               FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="열기" Click="OpenButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="편집" Click="EditButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="복사" Click="CopyButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="파일 위치" Click="OpenLocationButton_Click" Style="{StaticResource ViewerButtonStyle}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#0F172A"
                BorderBrush="#374151"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PreviousButton" Content="이전" Click="PreviousButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button x:Name="NextButton" Content="다음" Click="NextButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <TextBlock x:Name="PositionText" VerticalAlignment="Center" Foreground="#D1D5DB" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="−" Click="ZoomOutButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="44"/>
                    <Button Content="맞춤" Click="FitButton_Click" Style="{StaticResource ViewerButtonStyle}"/>
                    <Button Content="1:1" Click="ActualSizeButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="52"/>
                    <Button Content="+" Click="ZoomInButton_Click" Style="{StaticResource ViewerButtonStyle}" MinWidth="44"/>
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Foreground="#F9FAFB" FontWeight="SemiBold" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           Text="← → 이동 · Ctrl+휠 확대 · 파일 끌어놓기"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ImageScrollViewer"
                      Background="#111827"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Loaded="ImageScrollViewer_Loaded"
                      SizeChanged="ImageScrollViewer_SizeChanged"
                      PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
            <Grid x:Name="ImageSurface"
                  Margin="28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Border Background="#FFFFFF"
                        BorderBrush="#374151"
                        BorderThickness="1">
                    <Image x:Name="ViewerImage"
                           ContextMenu="{StaticResource ImageContextMenu}"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
