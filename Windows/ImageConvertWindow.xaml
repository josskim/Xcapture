<Window x:Class="XCapture.Windows.ImageConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 크기·형식 변환" Width="420" Height="355" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <StackPanel Margin="22">
        <TextBlock Text="이미지 변환" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
        <TextBlock Text="가로 / 세로 (픽셀)"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
            <TextBox x:Name="WidthBox" Width="135" Padding="7"/>
            <TextBlock Text=" × " VerticalAlignment="Center"/>
            <TextBox x:Name="HeightBox" Width="135" Padding="7"/>
        </StackPanel>
        <CheckBox x:Name="KeepRatio" Content="가로세로 비율 유지" IsChecked="True" Margin="0,0,0,12"/>
        <TextBlock Text="JPEG 품질 (1~100, 낮을수록 파일 크기 감소)"/>
        <TextBox x:Name="QualityBox" Text="90" Width="100" HorizontalAlignment="Left" Padding="7" Margin="0,5,0,12"/>
        <TextBlock Text="저장 창에서 JPEG, PNG 또는 BMP를 선택하세요." Foreground="#64748B" TextWrapping="Wrap"/>
        <Button Content="다른 이름으로 저장" Height="36" Margin="0,14,0,0" Click="Save_Click"/>
    </StackPanel>
</Window>
